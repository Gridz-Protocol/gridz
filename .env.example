# Gridz — copy to .env and fill in (never commit .env)
#   cp .env.example .env
#   pnpm bootstrap
#   pnpm bootstrap -- --deploy --ens --vercel

# Network
GRIDZ_CHAIN_ID=1
GRIDZ_RPC_URL=https://ethereum.publicnode.com
GRIDZ_ENS_RPC_URL=https://ethereum.publicnode.com
GRIDZ_ENS_BASE=gridz.eth
GRIDZ_ENS_NAME=gridz.eth

# Deployed GridzResolver proxy (set by bootstrap --deploy, or paste after manual deploy)
GRIDZ_RESOLVER=

# EAS (mainnet; Sepolia: 0xC2679fBD37d54388Ce493F1DB75320D236e1815e)
EAS_ADDRESS=0xC03e4De6924389f6Dfc89A41Eda71C41cd063315
CELL_SCHEMA=

# Keys — never commit real values
DEPLOYER_PRIVATE_KEY=
ADMIN_ADDRESS=
ENS_CONTROLLER_PRIVATE_KEY=
GRIDZ_SIGNER_KEY=

# 1Claw agent (https://1claw.xyz/for-ai)
ONECLAW_AGENT_ID=
ONECLAW_AGENT_KEY=
ONECLAW_ADDRESS=
ONECLAW_CHAIN_ID=1
ONECLAW_VAULT_ID=
GRIDZ_ONECLAW_API_KEY=

# Optional live tests
GRIDZ_ENS_TEST_KEY=

# Next.js (synced to examples/next-app/.env.local by bootstrap)
NEXT_PUBLIC_GRIDZ_ENS_BASE=gridz.eth
# Pinata (avatar uploads to public IPFS)
PINATA_JWT=
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_GATEWAY_URL=
PINATA_GATEWAY=gateway.pinata.cloud

