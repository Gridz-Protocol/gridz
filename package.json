{
  "name": "gridz",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Gridz — an open framework for cryptographically-attested social graphs for humans, AI agents, and organizations.",
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
